{
  "schemaVersion": 2,
  "name": "fatline",
  "description": "Rootless Podman and systemd-user composition qualification.",
  "components": {
    "agni": {
      "repository": "dash-xd/agni",
      "branch": "codex/coreos-fatline-qemu"
    },
    "logma": {
      "repository": "xd-dash/logma",
      "branch": "codex/fatline-keyspace-v2",
      "revision": "870c9f0c21796bb670cb6f1a142ca38fc21b653a",
      "checkout": "compositions/logma",
      "flake": "#provider-image",
      "image": "localhost/logma-provider:candidate"
    },
    "skymill": {
      "repository": "xd-dash/skymill",
      "branch": "codex/scoped-requirements-qualification",
      "revision": "907346ecd74a4d39830347b2ea01dc2b1c6b8969",
      "checkout": "compositions/skymill",
      "flake": "#provider-image",
      "image": "localhost/skymill-provider:scoped-qualification"
    }
  },
  "gates": {
    "baseline": {
      "description": "Composition baseline runtime",
      "modules": [
        "runtime-baseline"
      ]
    },
    "production-acl": {
      "description": "Tenant isolation and Skymill ACL checks against the production policy topology",
      "modules": [
        "runtime-production-acl"
      ]
    },
    "cold-start": {
      "description": "Logma-only coordinated cold start",
      "modules": [
        "runtime-cold-start"
      ]
    },
    "timer-recovery": {
      "description": "Redis crash, Function reconciliation, lifecycle and readiness recovery",
      "modules": [
        "runtime-timer-recovery"
      ]
    },
    "lifecycle-dispatch": {
      "description": "Lifecycle dispatch using the pinned Logma provider",
      "modules": [
        "runtime-lifecycle-dispatch"
      ]
    },
    "skymill-provider": {
      "description": "Skymill provider integration",
      "modules": [
        "runtime-skymill-provider"
      ]
    },
    "strict-readiness": {
      "description": "Readiness during Redis and Functions outage and recovery",
      "modules": [
        "runtime-strict-readiness"
      ]
    }
  },
  "all": [
    "baseline",
    "production-acl",
    "cold-start",
    "timer-recovery",
    "lifecycle-dispatch",
    "skymill-provider",
    "strict-readiness"
  ],
  "entrypoint": "local/fatline/qualification/run-plan.sh",
  "artifacts": {
    "redis": {
      "flake": "agni/local/fatline",
      "target": "#redis-image",
      "buildImage": "localhost/fatline-redis:candidate",
      "image": "localhost/nix-alpine/redis:qualified-2026.10.23"
    },
    "nginx": {
      "flake": "agni/local/fatline",
      "target": "#nginx-image",
      "buildImage": "localhost/fatline-nginx:candidate",
      "image": "localhost/nix-alpine/nginx:qualified-2026.10.23.1"
    }
  },
  "protocolVersion": 1,
  "modules": {
    "artifact-redis": {
      "kind": "nix.build-image",
      "phases": [
        "prepare",
        "verify"
      ],
      "inputs": {
        "artifact": "redis"
      },
      "outputs": [
        "image:redis"
      ],
      "dependsOn": [],
      "cleanup": {
        "policy": "preserve"
      }
    },
    "artifact-nginx": {
      "kind": "nix.build-image",
      "phases": [
        "prepare",
        "verify"
      ],
      "inputs": {
        "artifact": "nginx"
      },
      "outputs": [
        "image:nginx"
      ],
      "dependsOn": [],
      "cleanup": {
        "policy": "preserve"
      }
    },
    "provider-logma": {
      "kind": "nix.build-provider",
      "phases": [
        "prepare",
        "verify"
      ],
      "inputs": {
        "component": "logma"
      },
      "outputs": [
        "image:logma"
      ],
      "dependsOn": [],
      "cleanup": {
        "policy": "preserve"
      }
    },
    "provider-skymill": {
      "kind": "nix.build-provider",
      "phases": [
        "prepare",
        "verify"
      ],
      "inputs": {
        "component": "skymill"
      },
      "outputs": [
        "image:skymill"
      ],
      "dependsOn": [],
      "cleanup": {
        "policy": "preserve"
      }
    },
    "acl-policy": {
      "kind": "acl.verify-policy",
      "phases": [
        "prepare",
        "verify"
      ],
      "inputs": {
        "policy": "acl-policy.json"
      },
      "outputs": [
        "acl:policy-verified"
      ],
      "dependsOn": [
        "provider-logma",
        "provider-skymill"
      ],
      "cleanup": {
        "policy": "preserve"
      }
    },
    "runtime-baseline": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "baseline",
        "runtimeModes": {}
      },
      "outputs": [
        "gate:baseline:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    },
    "runtime-production-acl": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "production-acl",
        "runtimeModes": {
          "COMPOSITION_AGNI_RECONCILE_MODE": "1",
          "COMPOSITION_ACL_ISOLATION_MODE": "1",
          "COMPOSITION_SKYMILL_ACL_MODE": "1",
          "COMPOSITION_NGINX_QUADLET_MODE": "1",
          "COMPOSITION_REDIS_QUADLET_MODE": "1",
          "COMPOSITION_QUADLET_MODE": "1"
        }
      },
      "outputs": [
        "gate:production-acl:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma",
        "provider-skymill",
        "acl-policy"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    },
    "runtime-cold-start": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "cold-start",
        "runtimeModes": {
          "COMPOSITION_COLD_START_MODE": "1",
          "COMPOSITION_NGINX_QUADLET_MODE": "1",
          "COMPOSITION_REDIS_QUADLET_MODE": "1",
          "COMPOSITION_QUADLET_MODE": "1"
        }
      },
      "outputs": [
        "gate:cold-start:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    },
    "runtime-timer-recovery": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "timer-recovery",
        "runtimeModes": {
          "COMPOSITION_TIMER_STATE_MODE": "1",
          "COMPOSITION_LIFECYCLE_CRASH_MODE": "1",
          "COMPOSITION_FUNCTION_RECONCILE_MODE": "1",
          "COMPOSITION_REDIS_CRASH_BASELINE_MODE": "1",
          "COMPOSITION_COORDINATED_RESTART_MODE": "1",
          "COMPOSITION_BOOTSTRAP_UNIT_MODE": "1",
          "COMPOSITION_COLD_START_MODE": "1",
          "COMPOSITION_NGINX_QUADLET_MODE": "1",
          "COMPOSITION_REDIS_QUADLET_MODE": "1",
          "COMPOSITION_QUADLET_MODE": "1"
        }
      },
      "outputs": [
        "gate:timer-recovery:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    },
    "runtime-lifecycle-dispatch": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "lifecycle-dispatch",
        "runtimeModes": {
          "COMPOSITION_DISPATCH_MODE": "1"
        }
      },
      "outputs": [
        "gate:lifecycle-dispatch:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    },
    "runtime-skymill-provider": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "skymill-provider",
        "runtimeModes": {
          "COMPOSITION_SKYMILL_PROVIDER_MODE": "1",
          "COMPOSITION_NGINX_QUADLET_MODE": "1",
          "COMPOSITION_REDIS_QUADLET_MODE": "1",
          "COMPOSITION_QUADLET_MODE": "1"
        }
      },
      "outputs": [
        "gate:skymill-provider:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma",
        "provider-skymill"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    },
    "runtime-strict-readiness": {
      "kind": "podman-systemd.composition-gate",
      "phases": [
        "prepare",
        "execute",
        "verify",
        "cleanup"
      ],
      "inputs": {
        "gate": "strict-readiness",
        "runtimeModes": {
          "COMPOSITION_CRASH_WINDOW_MODE": "1",
          "COMPOSITION_STRICT_READINESS_MODE": "1",
          "COMPOSITION_LIFECYCLE_CRASH_MODE": "1",
          "COMPOSITION_FUNCTION_RECONCILE_MODE": "1",
          "COMPOSITION_REDIS_CRASH_BASELINE_MODE": "1",
          "COMPOSITION_COORDINATED_RESTART_MODE": "1",
          "COMPOSITION_BOOTSTRAP_UNIT_MODE": "1",
          "COMPOSITION_COLD_START_MODE": "1",
          "COMPOSITION_NGINX_QUADLET_MODE": "1",
          "COMPOSITION_REDIS_QUADLET_MODE": "1",
          "COMPOSITION_QUADLET_MODE": "1"
        }
      },
      "outputs": [
        "gate:strict-readiness:passed"
      ],
      "dependsOn": [
        "artifact-redis",
        "artifact-nginx",
        "provider-logma"
      ],
      "cleanup": {
        "policy": "retainable",
        "scope": "module-run",
        "override": "RETAIN"
      }
    }
  }
}
