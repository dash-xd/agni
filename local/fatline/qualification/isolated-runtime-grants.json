{
  "schema": 1,
  "scope": "fatline-qualifier",
  "grants": [
    {
      "volume": "nix-xd-state-secret-fatline",
      "destination": "/run/nix-xd/mounts/secrets",
      "access": "ro",
      "writer": "fatline-secrets",
      "reader": "fatline-qualifier"
    },
    {
      "volume": "nix-xd-state-control-fatline-input",
      "destination": "/run/nix-xd/mounts/fatline-input",
      "access": "ro",
      "writer": "fatline-controller",
      "reader": "fatline-qualifier"
    },
    {
      "volume": "nix-xd-state-control-fatline-evidence",
      "destination": "/run/nix-xd/mounts/evidence",
      "access": "rw",
      "writer": "fatline-qualifier",
      "reader": "fatline-qualifier"
    }
  ]
}
