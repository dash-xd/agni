{
  "schema": 1,
  "scope": "fatline-qualification",
  "grants": [
    {
      "volume": "nix-xd-state-secret-fatline-qualification",
      "destination": "/run/nix-xd/mounts/secrets",
      "access": "ro",
      "writer": "fatline-secrets",
      "reader": "fatline-qualification"
    },
    {
      "volume": "nix-xd-state-control-fatline-qualification-evidence",
      "destination": "/run/nix-xd/mounts/evidence",
      "access": "rw",
      "writer": "fatline-qualification",
      "reader": "fatline-qualification"
    }
  ]
}
