variant: fcos
version: 1.7.0
passwd:
  users:
    - name: wisp
      ssh_authorized_keys:
        - "@COREOS_TEST_SSH_PUBLIC_KEY@"
storage:
  files:
    - path: /var/lib/systemd/linger/wisp
      mode: 0644
      contents:
        inline: ''
    - path: /etc/polkit-1/rules.d/60-wisp-reboot.rules
      mode: 0644
      contents:
        inline: |
          polkit.addRule(function(action, subject) {
            if (subject.user == "wisp" &&
                (action.id == "org.freedesktop.login1.reboot" ||
                 action.id == "org.freedesktop.login1.reboot-multiple-sessions")) {
              return polkit.Result.YES;
            }
          });
systemd:
  units:
    - name: sshd.service
      enabled: true
    - name: var-mnt-fatlineinput.mount
      enabled: true
      contents: |
        [Unit]
        Description=Read-only Fatline qualification fixture via QEMU VirtIO 9P
        Before=multi-user.target

        [Mount]
        What=fatlineinput
        Where=/var/mnt/fatlineinput
        Type=9p
        Options=trans=virtio,version=9p2000.L,ro,nofail,nodev,nosuid,msize=262144
        DirectoryMode=0755

        [Install]
        WantedBy=multi-user.target
    - name: var-mnt-nixstore.mount
      enabled: true
      contents: |
        [Unit]
        Description=Read-only shared Nix store via QEMU VirtIO 9P
        Before=multi-user.target

        [Mount]
        What=nixstore
        Where=/var/mnt/nixstore
        Type=9p
        Options=trans=virtio,version=9p2000.L,ro,nofail,nodev,nosuid,msize=262144
        DirectoryMode=0755

        [Install]
        WantedBy=multi-user.target
