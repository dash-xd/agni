variant: fcos
version: 1.7.0
passwd:
  users:
    - name: wisp
      ssh_authorized_keys:
        - "@COREOS_TEST_SSH_PUBLIC_KEY@"
storage:
  files:
    - path: /var/lib/systemd/linger/wisp
      mode: 0644
      contents:
        inline: ''
systemd:
  units:
    - name: sshd.service
      enabled: true
    - name: var-mnt-nixstore.mount
      enabled: true
      contents: |
        [Unit]
        Description=Read-only shared Nix store via QEMU VirtIO 9P
        After=local-fs.target
        Before=multi-user.target

        [Mount]
        What=nixstore
        Where=/var/mnt/nixstore
        Type=9p
        Options=trans=virtio,version=9p2000.L,ro,nofail,nodev,nosuid,msize=262144
        DirectoryMode=0755

        [Install]
        WantedBy=multi-user.target
