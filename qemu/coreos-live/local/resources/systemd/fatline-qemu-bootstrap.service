[Unit]
Description=Fatline CoreOS transient Podman bootstrap qualification
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-run --quiet --pipe --wait --collect --unit=fatline-qemu-podman-smoke -- /usr/bin/podman info --format {{.Host.Arch}}
ExecStartPost=/usr/local/libexec/fatline-qemu-bootstrap-result
StandardOutput=append:/dev/ttyS0
StandardError=append:/dev/ttyS0
TimeoutStartSec=150s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
