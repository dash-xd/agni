[Unit]
Description=Fatline CoreOS system Podman bootstrap qualification
After=multi-user.target
OnFailure=fatline-qemu-bootstrap-failure.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman info --format {{.Host.Arch}}
ExecStartPost=/usr/local/libexec/fatline-qemu-bootstrap-result
StandardOutput=append:/dev/ttyS0
StandardError=append:/dev/ttyS0
TimeoutStartSec=150s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
