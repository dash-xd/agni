#!/usr/bin/bash
set -Eeuo pipefail

suffix="$(od -An -N6 -tx1 /dev/urandom | tr -d ' \\n')"
[[ "$suffix" =~ ^[a-f0-9]{12}$ ]] || {
  echo "Could not generate a valid local account suffix" >&2
  exit 1
}

composition="$(</etc/fatline/composition)"
[[ "$composition" =~ ^[a-z_][a-z0-9_-]{0,18}$ ]] || {
  echo "Invalid composition name in /etc/fatline/composition" >&2
  exit 1
}
username="$composition-$suffix"
workspace="/var/home/$username"
/usr/sbin/useradd --create-home --home-dir "$workspace" --user-group --shell /bin/bash "$username"
chmod 0700 "$workspace"
uid="$(/usr/bin/id -u "$username")"

install -d -m 0700 /run/fatline-console
printf '%s\n' "$username" > /run/fatline-console/username
printf 'FATLINE_CONSOLE_USER=%s\n' "$username" > /run/fatline-console/getty.env
printf 'FATLINE_CONSOLE_UID=%s\n' "$uid" > /run/fatline-console/user.env
chmod 0600 /run/fatline-console/username /run/fatline-console/getty.env /run/fatline-console/user.env

/usr/bin/loginctl enable-linger "$username"
printf 'Generated local login: %s\nWorkspace: %s\n' "$username" "$workspace" >/dev/ttyS0 2>/dev/null || true
