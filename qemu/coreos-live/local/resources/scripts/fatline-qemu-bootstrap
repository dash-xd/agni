#!/usr/bin/bash
set -Eeuo pipefail

unit=fatline-qemu-podman-smoke
if output="$(systemd-run --quiet --pipe --unit="$unit" --wait \
  /usr/bin/podman info --format '{{.Host.Arch}}' 2>&1)"; then
  printf 'Podman guest architecture: %s\n' "$output" >/dev/ttyS0
  printf 'PASS: transient systemd unit ran Podman inside Fedora CoreOS\n' >/dev/ttyS0
else
  rc=$?
  printf 'FAIL: transient systemd Podman smoke exited %s\n%s\n' "$rc" "$output" >/dev/ttyS0
  exit "$rc"
fi
