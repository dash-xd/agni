#!/usr/bin/bash
set -Eeuo pipefail

if [[ -r /run/fatline-console/username ]]; then
  username="$(</run/fatline-console/username)"
  composition="$(</etc/fatline/composition)"
  [[ "$composition" =~ ^[a-z_][a-z0-9_-]{0,18}$ ]] || {
    echo "Invalid composition name in /etc/fatline/composition" >&2
    exit 1
  }
  [[ "$username" == "$composition-"* ]] || {
    echo "Generated account does not match the selected composition" >&2
    exit 1
  }
  suffix="${username#"$composition-"}"
  [[ "$suffix" =~ ^[a-f0-9]{12}$ ]] || {
    echo "Invalid generated account suffix" >&2
    exit 1
  }
  uid="$(/usr/bin/id -u "$username")"
  marker="/run/user/$uid/fatline-user-smoke.pass"
  for _ in {1..120}; do
    if [[ -e "$marker" ]]; then
      echo "PASS: generated local user's systemd unit ran rootless Podman" >/dev/ttyS0
      echo "PASS: transient systemd unit ran Podman inside Fedora CoreOS" >/dev/ttyS0
      exit 0
    fi
    sleep 1
  done
  echo "Generated local user's systemd rootless Podman smoke did not pass within 120 seconds" >&2
  exit 1
fi

echo "PASS: transient systemd unit ran Podman inside Fedora CoreOS" >/dev/ttyS0
