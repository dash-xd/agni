variant: fcos
version: 1.7.0
systemd:
  units:
    - name: fatline-qemu-bootstrap.service
      enabled: true
      dropins:
        - name: 10-require-qualification-user.conf
          contents: |
            [Unit]
            Requires=fatline-console-user.service
            After=fatline-console-user.service
    - name: fatline-console-user.service
      enabled: true
    - name: getty@tty1.service
      dropins:
        - name: 10-fatline-console-autologin.conf
          contents: |
            [Unit]
            Requires=fatline-console-user.service
            After=fatline-console-user.service
            [Service]
            EnvironmentFile=/run/fatline-console/getty.env
            ExecStart=
            ExecStart=-/usr/sbin/agetty --autologin ${FATLINE_CONSOLE_USER} --noclear %I $TERM
storage:
  files:
    - path: /etc/systemd/system/fatline-qemu-bootstrap.service
      mode: 0644
      contents:
        local: systemd/fatline-qemu-bootstrap.service
    - path: /etc/systemd/system/fatline-console-user.service
      mode: 0644
      contents:
        local: systemd/fatline-console-user.service
    - path: /usr/local/libexec/fatline-console-user
      mode: 0755
      contents:
        local: scripts/fatline-console-user
    - path: /usr/local/libexec/fatline-qemu-bootstrap-result
      mode: 0755
      contents:
        local: scripts/fatline-qemu-bootstrap-result
    - path: /etc/fatline/composition
      mode: 0444
      contents:
        local: config/composition-name
    - path: /etc/skel/.config/systemd/user/fatline-qualification-smoke.service
      mode: 0644
      contents:
        local: systemd/fatline-qualification-smoke.service
  links:
    - path: /etc/skel/.config/systemd/user/default.target.wants/fatline-qualification-smoke.service
      target: ../fatline-qualification-smoke.service
      hard: false
