variant: fcos
version: 1.7.0
systemd:
  units:
    - name: fatline-qemu-bootstrap.service
      enabled: true
    - name: getty@tty1.service
      dropins:
        - name: 10-fatline-console-autologin.conf
          contents: |
            [Service]
            TTYVTDisallocate=no
            ExecStart=
            ExecStart=-/usr/sbin/agetty --autologin core --noclear %I $TERM
storage:
  files:
    - path: /etc/systemd/system/fatline-qemu-bootstrap.service
      mode: 0644
      contents:
        local: systemd/fatline-qemu-bootstrap.service
    - path: /usr/local/libexec/fatline-qemu-bootstrap
      mode: 0755
      contents:
        local: scripts/fatline-qemu-bootstrap
