variant: fcos
version: 1.7.0
systemd:
  units:
    - name: fatline-qemu-bootstrap.service
      enabled: true
storage:
  files:
    - path: /etc/systemd/system/fatline-qemu-bootstrap.service
      mode: 0644
      contents:
        local: systemd/fatline-qemu-bootstrap.service
    - path: /usr/local/libexec/fatline-qemu-bootstrap-result
      mode: 0755
      contents:
        local: scripts/fatline-qemu-bootstrap-result
    - path: /etc/systemd/system/fatline-qemu-bootstrap-failure.service
      mode: 0644
      contents:
        local: systemd/fatline-qemu-bootstrap-failure.service
    - path: /usr/local/libexec/fatline-qemu-bootstrap-failure
      mode: 0755
      contents:
        local: scripts/fatline-qemu-bootstrap-failure
    - path: /etc/fatline/composition
      mode: 0444
      contents:
        local: config/composition-name
