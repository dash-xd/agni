#!/usr/bin/env bash
set -euo pipefail

metadata() {
  curl --fail --silent --show-error \
    -H 'Metadata-Flavor: Google' \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/$1"
}

role="$(metadata agni-role)"
leader_ip="$(metadata agni-leader-ip)"
subnet_cidr="$(metadata agni-subnet-cidr)"
client_cidrs="$(metadata agni-client-cidrs || true)"
member_ips="$(metadata agni-member-ips || true)"
upstream_port="$(metadata agni-nginx-upstream-port)"
cloudflare_https="$(metadata agni-cloudflare-https || echo false)"
cloudflare_hostname="$(metadata agni-cloudflare-hostname || true)"

install -d -m 0755 /etc/agni /var/lib/agni/squid /var/lib/agni/nginx /var/lib/agni/nginx/tls

if [[ "$role" == "leader" ]]; then
  touch /etc/agni/leader
  cat > /etc/default/proxy <<EOF
NO_PROXY=localhost,127.0.0.1,::1,169.254.169.254,metadata.google.internal,.google.internal,${leader_ip}
no_proxy=localhost,127.0.0.1,::1,169.254.169.254,metadata.google.internal,.google.internal,${leader_ip}
EOF

  {
    echo 'http_port 0.0.0.0:3128'
    echo
    if [[ -n "$client_cidrs" ]]; then
      IFS=',' read -r -a cidrs <<< "$client_cidrs"
      for cidr in "${cidrs[@]}"; do
        [[ -n "$cidr" ]] && printf 'acl agni_clients src %s\n' "$cidr"
      done
    else
      printf 'acl agni_clients src %s\n' "$subnet_cidr"
    fi
    cat <<'EOF'
acl localhost src 127.0.0.1/32
acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost
http_access allow agni_clients
http_access deny all

access_log stdio:/var/log/squid/access.log
EOF
  } > /var/lib/agni/squid/squid.conf

  {
    echo 'upstream agni_members {'
    if [[ -n "$member_ips" ]]; then
      IFS=',' read -r -a members <<< "$member_ips"
      for ip in "${members[@]}"; do
        [[ -n "$ip" ]] && printf '    server %s:%s;\n' "$ip" "$upstream_port"
      done
    else
      echo '    server 127.0.0.1:65535;'
    fi
    echo '}'

    if [[ "$cloudflare_https" == "true" ]]; then
      cat <<EOF
server {
    listen 443 ssl default_server;
    server_name ${cloudflare_hostname};

    ssl_certificate     /etc/nginx/tls/origin.crt;
    ssl_certificate_key /etc/nginx/tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        access_log off;
        return 200 'ok\n';
        add_header Content-Type text/plain;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://agni_members;
    }
}
EOF
    else
      cat <<'EOF'
server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://agni_members;
    }
}
EOF
    fi
  } > /var/lib/agni/nginx/default.conf

  if [[ "$cloudflare_https" == "true" ]]; then
    metadata agni-origin-certificate-b64 | base64 --decode > /var/lib/agni/nginx/tls/origin.crt
    metadata agni-origin-private-key-b64 | base64 --decode > /var/lib/agni/nginx/tls/origin.key
    chmod 0644 /var/lib/agni/nginx/tls/origin.crt
    chmod 0600 /var/lib/agni/nginx/tls/origin.key
  fi
else
  rm -f /etc/agni/leader
  cat > /etc/default/proxy <<EOF
HTTP_PROXY=http://${leader_ip}:3128
HTTPS_PROXY=http://${leader_ip}:3128
NO_PROXY=localhost,127.0.0.1,::1,169.254.169.254,metadata.google.internal,.google.internal,${leader_ip}
http_proxy=http://${leader_ip}:3128
https_proxy=http://${leader_ip}:3128
no_proxy=localhost,127.0.0.1,::1,169.254.169.254,metadata.google.internal,.google.internal,${leader_ip}
EOF
fi

chmod 0644 /etc/default/proxy
systemctl daemon-reload
