variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      groups: ["wheel"]
      shell: /bin/bash

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: agni-coreos

    - path: /etc/default/axiom
      mode: 0600
      contents:
        inline: |
          AXIOM_TOKEN=
          AXIOM_DATASET=
          AXIOM_DOMAIN=api.axiom.co

    - path: /etc/profile.d/systemd-pager.sh
      mode: 0644
      contents:
        inline: |
          export SYSTEMD_PAGER=cat

    - path: /etc/profile.d/proxy.sh
      mode: 0644
      contents:
        inline: |
          [ -f /etc/default/proxy ] && source /etc/default/proxy

    - path: /usr/local/bin/agni-bootstrap
      mode: 0755
      contents:
        local: agni-bootstrap

    - path: /usr/local/bin/agni-security-cell-agent
      mode: 0755
      contents:
        local: agni-security-cell-agent

    - path: /usr/local/bin/send-journal-to-axiom
      mode: 0755
      contents:
        local: send-journal-to-axiom

    - path: /etc/containers/systemd/agni-squid.container
      mode: 0644
      contents:
        local: agni-squid.container

    - path: /etc/containers/systemd/agni-nginx.container
      mode: 0644
      contents:
        local: agni-nginx.container

    - path: /etc/systemd/system/agni-bootstrap.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Configure Agni leader/member networking
          Wants=network-online.target
          After=network-online.target
          Before=rpm-ostreed.service send-journal-to-axiom.service agni-security-cell.service

          [Service]
          Type=oneshot
          ExecStart=/usr/local/bin/agni-bootstrap
          RemainAfterExit=yes

          [Install]
          WantedBy=multi-user.target

    - path: /etc/systemd/system/agni-security-cell.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Reconcile Agni regional security cell runtime
          Wants=network-online.target
          After=network-online.target agni-bootstrap.service
          Requires=agni-bootstrap.service

          [Service]
          Type=oneshot
          EnvironmentFile=-/etc/default/proxy
          ExecStart=/usr/local/bin/agni-security-cell-agent
          RemainAfterExit=yes

          [Install]
          WantedBy=multi-user.target

    - path: /etc/systemd/system/send-journal-to-axiom.service
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Send journal logs to Axiom in NDJSON format
          Wants=network-online.target
          After=network-online.target agni-bootstrap.service
          Requires=agni-bootstrap.service

          [Service]
          Type=oneshot
          EnvironmentFile=-/etc/default/proxy
          EnvironmentFile=/etc/default/axiom
          ExecStart=/usr/local/bin/send-journal-to-axiom

          [Install]
          WantedBy=multi-user.target

    - path: /home/core/.config/systemd/user/podman.socket.d/10-proxy.conf
      mode: 0644
      contents:
        inline: |
          [Service]
          EnvironmentFile=-/etc/default/proxy

systemd:
  units:
    - name: serial-getty@ttyS0.service
      dropins:
        - name: autologin-core.conf
          contents: |
            [Service]
            ExecStart=
            ExecStart=-/usr/sbin/agetty --autologin core --noclear %I $TERM
            TTYVTDisallocate=no

    - name: sshd.service
      enabled: true

    - name: agni-bootstrap.service
      enabled: true

    - name: agni-security-cell.service
      enabled: true

    - name: rpm-ostreed.service
      dropins:
        - name: 10-proxy.conf
          contents: |
            [Unit]
            After=agni-bootstrap.service
            Requires=agni-bootstrap.service

            [Service]
            EnvironmentFile=-/etc/default/proxy

    - name: send-journal-to-axiom.service
      enabled: true
