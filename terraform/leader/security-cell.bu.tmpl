variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      groups: ["wheel"]
      shell: /bin/bash

storage:
  directories:
    - path: /etc/agni
      mode: 0755
    - path: /etc/containers/systemd
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: agni-security-cell

    - path: /usr/local/bin/agni-artifact-registry-login
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail

          root=/run/agni-security-cell
          authfile="$root/containers-auth.json"
          install -d -m 0700 "$root"

          token_json="$(curl --fail --silent --show-error \
            -H 'Metadata-Flavor: Google' \
            'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token')"
          token="$(printf '%s' "$token_json" | sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
          test -n "$token"

          printf '%s' "$token" | podman login \
            --authfile "$authfile" \
            --username oauth2accesstoken \
            --password-stdin \
            '${REGISTRY_HOST}'
          chmod 0600 "$authfile"
          unset token token_json

    - path: /usr/local/bin/agni-security-cell-init
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail
          umask 077

          root=/run/agni-security-cell
          marai_app="$root/marai-app"
          marai_admin="$root/marai-admin"
          prajapati="$root/prajapati"

          install -d -m 0700 "$root" "$marai_admin" "$prajapati"
          install -d -m 0770 "$marai_app"
          chown root:65532 "$marai_app"

          if [[ ! -s "$marai_admin/admin.password" ]]; then
            head -c 48 /dev/urandom | base64 -w0 > "$marai_admin/admin.password"
          fi
          if [[ ! -s "$marai_app/app.password" ]]; then
            head -c 48 /dev/urandom | base64 -w0 > "$marai_app/app.password"
          fi

          chown root:root "$marai_admin/admin.password"
          chmod 0400 "$marai_admin/admin.password"
          chown root:65532 "$marai_app/app.password"
          chmod 0440 "$marai_app/app.password"

          # Principal/audience/policy data is supplied by Huram/the caller as
          # non-secret deployment data. Agni only materializes it.
          printf '%s' '${PRAJAPATI_TENANT_REGISTRY_B64}' \
            | base64 -d > "$prajapati/tenants.json"
          chown root:65532 "$prajapati/tenants.json"
          chmod 0440 "$prajapati/tenants.json"

          # Prajapati may target only the application side of this cell.
          test -s "$prajapati/tenants.json"
          grep -q '"socket"' "$prajapati/tenants.json"
          grep -q '/run/marai/redis.sock' "$prajapati/tenants.json"
          grep -q '"user"[[:space:]]*:[[:space:]]*"marai-app"' "$prajapati/tenants.json"
          grep -q '"password_file"[[:space:]]*:[[:space:]]*"/run/marai/app.password"' "$prajapati/tenants.json"
          if grep -q 'marai-admin' "$prajapati/tenants.json"; then
            echo "Prajapati tenant registry must not reference marai-admin" >&2
            exit 1
          fi

    - path: /etc/containers/systemd/marai.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Marai security-cell cryptographic authority
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service
          Requires=agni-security-cell-init.service
          Before=prajapati.service

          [Container]
          Image=${MARAI_IMAGE}
          ContainerName=marai
          Network=none
          Volume=/run/agni-security-cell/marai-app:/run/marai-app:rw,z
          Volume=/run/agni-security-cell/marai-admin:/run/marai-admin:ro,z
          Environment=MARAI_REDIS_PORT=0
          Environment=MARAI_REDIS_SOCKET=/run/marai-app/redis.sock
          Environment=MARAI_REDIS_SOCKET_MODE=660
          Environment=MARAI_ADMIN_PASSWORD_FILE=/run/marai-admin/admin.password
          Environment=MARAI_APP_PASSWORD_FILE=/run/marai-app/app.password
          NoNewPrivileges=true
          DropCapability=all

          [Service]
          Restart=no
          Environment=REGISTRY_AUTH_FILE=/run/agni-security-cell/containers-auth.json
          # Redis creates the socket as the Marai container user. Give only the
          # Prajapati runtime group access before Prajapati starts.
          ExecStartPost=/usr/bin/chgrp 65532 /run/agni-security-cell/marai-app/redis.sock
          ExecStartPost=/usr/bin/chmod 0660 /run/agni-security-cell/marai-app/redis.sock

          [Install]
          WantedBy=multi-user.target

    - path: /etc/containers/systemd/prajapati.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Prajapati authenticated application ingress for one security cell
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service marai.service
          Requires=agni-security-cell-init.service marai.service

          [Container]
          Image=${PRAJAPATI_IMAGE}
          ContainerName=prajapati
          PublishPort=127.0.0.1:8443:8443
          Volume=/run/agni-security-cell/prajapati/tenants.json:/run/prajapati/tenants.json:ro,z
          Volume=/run/agni-security-cell/marai-app:/run/marai:ro,z
          Environment=PRAJAPATI_TENANT_REGISTRY_FILE=/run/prajapati/tenants.json
          Environment=PRAJAPATI_LISTEN=:8443
          Environment=PRAJAPATI_ALLOW_INSECURE_HTTP=1
          NoNewPrivileges=true
          DropCapability=all
          ReadOnly=true

          [Service]
          Restart=on-failure
          RestartSec=2s
          Environment=REGISTRY_AUTH_FILE=/run/agni-security-cell/containers-auth.json

          [Install]
          WantedBy=multi-user.target

systemd:
  units:
    - name: sshd.service
      enabled: true

    - name: agni-artifact-registry-login.service
      enabled: true
      contents: |
        [Unit]
        Description=Authenticate Podman to Artifact Registry using a run-scoped auth file
        Wants=network-online.target
        After=network-online.target
        Before=marai.service prajapati.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/agni-artifact-registry-login
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target

    - name: agni-security-cell-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Materialize generic security-cell runtime inputs
        Before=marai.service prajapati.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/agni-security-cell-init
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
