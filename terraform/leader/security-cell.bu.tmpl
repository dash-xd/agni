variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      groups: ["wheel"]
      shell: /bin/bash

storage:
  directories:
    - path: /etc/agni
      mode: 0755
    - path: /etc/containers/systemd
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: agni-security-cell

    - path: /usr/local/bin/agni-artifact-registry-login
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail

          root=/run/agni-security-cell
          authfile="$root/containers-auth.json"
          install -d -m 0700 "$root"

          token_json="$(curl --fail --silent --show-error \
            -H 'Metadata-Flavor: Google' \
            'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token')"
          token="$(printf '%s' "$token_json" | sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
          test -n "$token"

          # Keep the short-lived registry credential on /run rather than in
          # Podman's normal persistent auth location.
          printf '%s' "$token" | podman login \
            --authfile "$authfile" \
            --username oauth2accesstoken \
            --password-stdin \
            '${REGISTRY_HOST}'
          chmod 0600 "$authfile"
          unset token token_json

    - path: /usr/local/bin/agni-security-cell-init
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail
          umask 077

          root=/run/agni-security-cell
          marai="$root/marai"
          atman="$root/atman"
          install -d -m 0700 "$root" "$marai" "$atman"

          if [[ ! -s "$marai/admin.password" ]]; then
            head -c 48 /dev/urandom | base64 -w0 > "$marai/admin.password"
          fi
          if [[ ! -s "$marai/app.password" ]]; then
            head -c 48 /dev/urandom | base64 -w0 > "$marai/app.password"
          fi

          # These files are deliberately readable inside explicitly mounted
          # containers; the host and the selected bind mounts are the trust
          # boundary. The parent /run directories remain 0700 on the host.
          chmod 0444 "$marai/admin.password" "$marai/app.password"

          # Tenant/caller/audience policy is supplied by Huram/the caller as
          # non-secret deployment data. Agni does not know tenant names,
          # projects, service accounts, or provider profile semantics.
          printf '%s' '${ATMAN_TENANT_REGISTRY_B64}' \
            | base64 -d > "$atman/tenants.json"
          chmod 0444 "$atman/tenants.json"

          # Fail bootstrap if the materialized registry is empty or does not
          # reference this cell's local Marai application boundary.
          test -s "$atman/tenants.json"
          grep -q '"socket"' "$atman/tenants.json"
          grep -q '/run/marai/redis.sock' "$atman/tenants.json"
          grep -q '"user"[[:space:]]*:[[:space:]]*"marai-app"' "$atman/tenants.json"

    - path: /etc/containers/systemd/marai.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Marai security-cell cryptographic authority
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service
          Requires=agni-security-cell-init.service
          Before=atman.service

          [Container]
          Image=${MARAI_IMAGE}
          ContainerName=marai
          Network=none
          Volume=/run/agni-security-cell/marai:/run/marai:rw,z
          Environment=MARAI_REDIS_PORT=0
          Environment=MARAI_REDIS_SOCKET=/run/marai/redis.sock
          Environment=MARAI_REDIS_SOCKET_MODE=777
          Environment=MARAI_ADMIN_PASSWORD_FILE=/run/marai/admin.password
          Environment=MARAI_APP_PASSWORD_FILE=/run/marai/app.password
          NoNewPrivileges=true
          DropCapability=all

          [Service]
          # Marai process loss is authority loss. Never silently replace it
          # with a fresh empty KMS and pretend continuity. Recovery is an
          # explicit Huram lifecycle operation using an MRS1 checkpoint.
          Restart=no
          Environment=REGISTRY_AUTH_FILE=/run/agni-security-cell/containers-auth.json

          [Install]
          WantedBy=multi-user.target

    - path: /etc/containers/systemd/atman.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Atman authenticated application ingress for one security cell
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service marai.service
          Requires=agni-security-cell-init.service marai.service

          [Container]
          Image=${ATMAN_IMAGE}
          ContainerName=atman
          PublishPort=127.0.0.1:8443:8443
          Volume=/run/agni-security-cell/atman/tenants.json:/run/atman/tenants.json:ro,z
          Volume=/run/agni-security-cell/marai:/run/marai:ro,z
          Environment=ATMAN_TENANT_REGISTRY_FILE=/run/atman/tenants.json
          Environment=ATMAN_LISTEN=:8443
          Environment=ATMAN_ALLOW_INSECURE_HTTP=1
          NoNewPrivileges=true
          DropCapability=all
          ReadOnly=true

          [Service]
          # Atman is stateless ingress and may restart. Its readiness is tied
          # to KMS.STATUS=active, so restarting Atman cannot recreate Marai
          # authority or make a quiesced/dead cell ready again.
          Restart=on-failure
          RestartSec=2s
          Environment=REGISTRY_AUTH_FILE=/run/agni-security-cell/containers-auth.json

          [Install]
          WantedBy=multi-user.target

systemd:
  units:
    - name: sshd.service
      enabled: true

    - name: agni-artifact-registry-login.service
      enabled: true
      contents: |
        [Unit]
        Description=Authenticate Podman to Artifact Registry using a run-scoped auth file
        Wants=network-online.target
        After=network-online.target
        Before=marai.service atman.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/agni-artifact-registry-login
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target

    - name: agni-security-cell-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Materialize generic security-cell runtime inputs
        Before=marai.service atman.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/agni-security-cell-init
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
