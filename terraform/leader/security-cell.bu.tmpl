variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      groups: ["wheel"]
      shell: /bin/bash

storage:
  directories:
    - path: /etc/agni
      mode: 0755
    - path: /etc/containers/systemd
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: agni-security-leader

    - path: /usr/local/bin/agni-artifact-registry-login
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail

          token_json="$(curl --fail --silent --show-error \
            -H 'Metadata-Flavor: Google' \
            'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token')"
          token="$(printf '%s' "$token_json" | sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
          test -n "$token"
          printf '%s' "$token" | podman login \
            --username oauth2accesstoken \
            --password-stdin \
            '${REGISTRY_HOST}'

    - path: /usr/local/bin/agni-security-cell-init
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail
          umask 077

          root=/run/agni-security-cell
          install -d -m 0700 "$root" "$root/atman"

          init_tenant() {
            local tenant="$1"
            local dir="$root/$tenant"
            install -d -m 0777 "$dir"

            if [[ ! -s "$dir/admin.password" ]]; then
              head -c 48 /dev/urandom | base64 -w0 > "$dir/admin.password"
            fi
            if [[ ! -s "$dir/app.password" ]]; then
              head -c 48 /dev/urandom | base64 -w0 > "$dir/app.password"
            fi

            # These files cross container UID boundaries. The host is already the
            # trust boundary; tenant containers only receive explicitly mounted dirs.
            chmod 0444 "$dir/admin.password" "$dir/app.password"
          }

          init_tenant logma
          init_tenant agni

          cat > "$root/atman/tenants.json" <<'EOF'
          {
            "tenants": {
              "logma": {
                "audiences": [
                  "https://security.internal/logma"
                ],
                "callers": [
                  "logma-us-west1@dashxd.iam.gserviceaccount.com",
                  "logma-us-central1@dashxd.iam.gserviceaccount.com"
                ],
                "marai": {
                  "socket": "/run/marai/logma/redis.sock",
                  "user": "marai-app",
                  "password_file": "/run/marai/logma/app.password"
                }
              },
              "agni": {
                "audiences": [
                  "https://security.internal/agni"
                ],
                "callers": [
                  "agni-runtime@dashxd.iam.gserviceaccount.com"
                ],
                "marai": {
                  "socket": "/run/marai/agni/redis.sock",
                  "user": "marai-app",
                  "password_file": "/run/marai/agni/app.password"
                }
              }
            }
          }
          EOF
          chmod 0444 "$root/atman/tenants.json"

    - path: /etc/containers/systemd/marai-logma.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Marai KMS for logma tenant
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service
          Requires=agni-security-cell-init.service
          Before=atman.service

          [Container]
          Image=${MARAI_IMAGE}
          ContainerName=marai-logma
          Network=none
          Volume=/run/agni-security-cell/logma:/run/marai:rw,z
          Environment=MARAI_REDIS_PORT=0
          Environment=MARAI_REDIS_SOCKET=/run/marai/redis.sock
          Environment=MARAI_REDIS_SOCKET_MODE=777
          Environment=MARAI_ADMIN_PASSWORD_FILE=/run/marai/admin.password
          Environment=MARAI_APP_PASSWORD_FILE=/run/marai/app.password
          NoNewPrivileges=true
          DropCapability=all

          [Service]
          Restart=on-failure
          RestartSec=2s

          [Install]
          WantedBy=multi-user.target

    - path: /etc/containers/systemd/marai-agni.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Marai KMS for agni tenant
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service
          Requires=agni-security-cell-init.service
          Before=atman.service

          [Container]
          Image=${MARAI_IMAGE}
          ContainerName=marai-agni
          Network=none
          Volume=/run/agni-security-cell/agni:/run/marai:rw,z
          Environment=MARAI_REDIS_PORT=0
          Environment=MARAI_REDIS_SOCKET=/run/marai/redis.sock
          Environment=MARAI_REDIS_SOCKET_MODE=777
          Environment=MARAI_ADMIN_PASSWORD_FILE=/run/marai/admin.password
          Environment=MARAI_APP_PASSWORD_FILE=/run/marai/app.password
          NoNewPrivileges=true
          DropCapability=all

          [Service]
          Restart=on-failure
          RestartSec=2s

          [Install]
          WantedBy=multi-user.target

    - path: /etc/containers/systemd/atman.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Atman multi-tenant authentication and KMS gateway
          Wants=network-online.target
          After=network-online.target agni-artifact-registry-login.service agni-security-cell-init.service marai-logma.service marai-agni.service
          Requires=agni-security-cell-init.service marai-logma.service marai-agni.service

          [Container]
          Image=${ATMAN_IMAGE}
          ContainerName=atman
          Network=host
          Volume=/run/agni-security-cell/atman/tenants.json:/run/atman/tenants.json:ro,z
          Volume=/run/agni-security-cell/logma:/run/marai/logma:ro,z
          Volume=/run/agni-security-cell/agni:/run/marai/agni:ro,z
          Environment=ATMAN_TENANT_REGISTRY_FILE=/run/atman/tenants.json
          Environment=ATMAN_LISTEN=127.0.0.1:8443
          Environment=ATMAN_ALLOW_INSECURE_HTTP=1
          NoNewPrivileges=true
          DropCapability=all
          ReadOnly=true

          [Service]
          Restart=on-failure
          RestartSec=2s

          [Install]
          WantedBy=multi-user.target

systemd:
  units:
    - name: sshd.service
      enabled: true

    - name: agni-artifact-registry-login.service
      enabled: true
      contents: |
        [Unit]
        Description=Authenticate Podman to Artifact Registry
        Wants=network-online.target
        After=network-online.target
        Before=marai-logma.service marai-agni.service atman.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/agni-artifact-registry-login
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target

    - name: agni-security-cell-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Initialize ephemeral credentials and Atman tenant registry
        Before=marai-logma.service marai-agni.service atman.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/agni-security-cell-init
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
